{
  "name": "@your-org/types-depot",
  "version": "0.0.101",
  "description": "Types depot for your org/project.",
  "main": "index.js",
  "scripts": {
    "test": "echo 'noop'",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ORESoftware/types-depot.git"
  },
  "keywords": [
    "types",
    "type-creator",
    "static-typing",
    "types-depot",
    "types-repo",
    "type-depot",
    "type-repo",
    "type-repot"
  ],
  "readme": "readme.md",
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ORESoftware/types-depot/issues"
  },
  "homepage": "https://github.com/ORESoftware/types-depot#readme",
  "dependencies": {
    "type-creator": "file:../type-creator"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
